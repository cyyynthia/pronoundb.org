{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"types": [ "vite/client" ],
		"lib": [ "esnext", "dom", "dom.iterable" ],

		"jsx": "preserve",
		"jsxFactory": "h",
		"jsxFragmentFactory": "Fragment",

		"noUncheckedIndexedAccess": false,
		"noPropertyAccessFromIndexSignature": false
	},
	"include": [ "./src/**/*", "vite.config.ts" ]
}
