{
	"extends": "astro/tsconfigs/strictest",
	"compilerOptions": {
		"types": [ "astro/client" ],
		"paths": {
			"@assets/*": [ "./src/assets/*" ],
			"@components/*": [ "./src/components/*" ],
			"@layouts/*": [ "./src/layouts/*" ],
			"@server/*": [ "./src/server/*" ]
		}
	},
	"include": [
		".astro/types.d.ts",
		"astro.config.ts",
		"src"
	]
}
